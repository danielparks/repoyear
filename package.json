{
  "name": "repoyear",
  "private": true,
  "version": "0.8.1",
  "type": "module",
  "scripts": {
    "dev": "npm run generate:api:watch & vite",
    "build": "npm run generate:api && vite build",
    "preview": "vite preview",
    "vitest": "vitest",
    "vitest:ui": "vitest --ui",
    "vitest:run": "vitest run",
    "backend": "cd backend && deno run start",
    "generate:api": "scripts/generate-api.sh",
    "generate:api:watch": "chokidar src/api/openapi.json -c 'npm run generate:api' --initial --silent",
    "generate:graphql": "deno run -A npm:@graphql-codegen/cli/graphql-codegen-esm --config src/github/codegen_config.ts",
    "generate:fixture": "deno run -A scripts/generate-fixture.ts"
  },
  "dependencies": {
    "@deno/vite-plugin": "^2.0.3",
    "@octokit/core": "^7.0.7",
    "@octokit/graphql": "^9.0.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "@types/react": "^19.2.18",
    "@vitejs/plugin-react": "^6.0.5",
    "fast-deep-equal": "^3.1.3",
    "idb-keyval": "^6.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2"
  },
  "devDependencies": {
    "@graphql-codegen/add": "^7.1.0",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react-dom": "^19.2.4",
    "@vitest/ui": "^4.1.10",
    "chokidar-cli": "^3.0.0",
    "globals": "^17.9.0",
    "graphql": "^16.14.2",
    "happy-dom": "^20.11.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
