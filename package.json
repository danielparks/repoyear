{
  "name": "repoyear",
  "private": true,
  "version": "0.8.1",
  "type": "module",
  "scripts": {
    "dev": "npm run generate:api:watch & vite",
    "build": "npm run generate:api && vite build",
    "preview": "vite preview",
    "vitest": "vitest",
    "vitest:ui": "vitest --ui",
    "vitest:run": "vitest run",
    "generate:api": "scripts/generate-api.sh",
    "generate:api:watch": "chokidar src/api/openapi.json -c 'npm run generate:api' --initial --silent",
    "generate:graphql": "deno run -A npm:@graphql-codegen/cli/graphql-codegen-esm --config src/github/codegen_config.ts",
    "generate:fixture": "deno run -A scripts/generate-fixture.ts"
  },
  "dependencies": {
    "@deno/vite-plugin": "^2.0.4",
    "@octokit/core": "^7.0.8",
    "@octokit/graphql": "^9.0.5",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fast-deep-equal": "^3.1.3",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6"
  },
  "devDependencies": {
    "@graphql-codegen/add": "^7.1.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react-dom": "^19.3.0",
    "@vitest/ui": "^5.1.0",
    "chokidar-cli": "^3.0.0",
    "globals": "^17.14.0",
    "graphql": "^16.14.2",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
