{
  "openapi": "3.0.3",
  "info": {
    "title": "RepoYear API",
    "version": "0.8.1"
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Health status (always `\"ok\"`). This indicates that the API server is up and nothing more."
          }
        },
        "required": [
          "status"
        ]
      },
      "VersionResponse": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "description": "Version string from git describe."
          }
        },
        "required": [
          "version"
        ]
      },
      "ContributionsResponse": {
        "type": "object",
        "properties": {
          "repos": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "description": "Repository commit times (seconds since epoch) by repository name."
          }
        },
        "required": [
          "repos"
        ]
      },
      "OAuthTokenResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "The access token from GitHub."
          },
          "refresh_token": {
            "type": "string",
            "description": "The refresh token from GitHub (if tokens are set to expire)."
          },
          "expires_in": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of seconds until the access token expires."
          },
          "refresh_token_expires_in": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of seconds until the refresh token expires."
          }
        },
        "required": [
          "access_token"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "error_code": {
            "type": "string"
          }
        },
        "required": [
          "message",
          "request_id"
        ],
        "description": "Error information from a response."
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health_check",
        "summary": "Handle `/api/health`",
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/version": {
      "get": {
        "operationId": "version",
        "summary": "Handle `/api/version`",
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/contributions": {
      "get": {
        "operationId": "contributions",
        "summary": "Handle `/api/contributions`",
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContributionsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/oauth/callback": {
      "get": {
        "operationId": "oauth_callback",
        "summary": "Handle `/api/oauth/callback`",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "The code from GitHub."
            },
            "required": true,
            "description": "The code from GitHub.",
            "name": "code",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthTokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/oauth/refresh": {
      "get": {
        "operationId": "oauth_refresh",
        "summary": "Handle `/api/oauth/refresh`",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "The refresh token from GitHub."
            },
            "required": true,
            "description": "The refresh token from GitHub.",
            "name": "refresh_token",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthTokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
